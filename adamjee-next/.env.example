# MongoDB Connection String (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adamjee-db?retryWrites=true&w=majority

# JWT Settings
# REQUIRED. Must be at least 32 random characters — the app refuses to start in
# production without it. Generate one with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d

# Google Sign-In. Without this, /api/auth/google is disabled in production.
GOOGLE_CLIENT_ID=

# Transactional email (password reset codes, order confirmations).
# Without it, reset codes cannot be delivered.
RESEND_API_KEY=
ADMIN_EMAIL=support@adamjeecomputers.com

# AI Chatbot & Description Generator API Key (OpenRouter or OpenAI)
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_or_openai_api_key_here

# App URL
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app

# Safepay Payment Gateway (Optional)
SAFEPAY_MODE=sandbox
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
# REQUIRED to accept card payments: webhooks are rejected without it, so orders
# would never be marked paid.
SAFEPAY_WEBHOOK_SECRET=

# Automated Email Configuration (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@adamjeecomputers.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=no-reply@adamjeecomputers.com
SMTP_FROM_NAME=Adamjee Computers
